# ── Service ──
PORT=4010
NODE_ENV=development
API_PREFIX=v1
CORS_ORIGINS=http://localhost:5173
INTERNAL_API_SECRET=

# ── Base de données (schéma dédié "paiement") ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=paiement
DB_SSL=false

# ── Redis / RabbitMQ ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_URL=
RABBITMQ_QUEUE_PAIEMENT=paiement.rpc

# ── Identité (vérification des jetons) ──
JWT_ACCESS_SECRET=
JWT_ISSUER=api-identite.sigapei.com

# ── Chiffrement (JAMAIS de valeur réelle dans le dépôt) ──
# Générer chaque clé :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLES_CHIFFREMENT={"1":""}
CLE_CHIFFREMENT_COURANTE=1
CLE_EMPREINTE=

# ── Agrégateurs : les clés API seront ajoutées avec les phases FedaPay / CinetPay (variables d'environnement uniquement) ──

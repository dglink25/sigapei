APP_NAME=vie-scolaire
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4005

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Regle n°1 - Une seule base, un schema par microservice
# ============================================================
# Base PostgreSQL unique de la plateforme (Neon). Host, port, base,
# utilisateur et mot de passe sont STRICTEMENT les memes que ceux
# deja utilises par identite et etablissements : ils sont fournis
# par le chef de projet, ils ne se redemandent pas et on ne cree
# jamais une base supplementaire.
# Seul DB_SCHEMA change d'un microservice a l'autre.
DB_CONNECTION=pgsql
DB_HOST=your-neon-project.pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me

# Schema proprietaire de ce microservice (nom du dossier, en underscore).
# Il doit exister sur Neon AVANT la premiere migration, cree a la main :
#   psql "postgresql://<user>:<pass>@<db-host>/<db-name>?sslmode=require"
#   CREATE SCHEMA IF NOT EXISTS vie_scolaire;
#   \q
DB_SCHEMA=vie_scolaire

# Neon refuse les connexions non chiffrees : obligatoire.
DB_SSLMODE=require

# ============================================================
# Regle n°2 - Redis et RabbitMQ partages, pas dupliques
# ============================================================
# Ne jamais faire tourner son propre conteneur Redis / RabbitMQ.
# REDIS_HOST=redis et RABBITMQ_HOST=rabbitmq designent les
# conteneurs partages, joignables via le reseau Docker externe
# `sigapei`. Mettre `localhost` uniquement en developpement
# hors Docker.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Un numero de base different par microservice pour ne pas melanger
# les cles : identite=0, etablissements=1, vie_scolaire=2.
REDIS_DB=2
REDIS_CACHE_DB=3
# Prefixe de cles : le double filet de securite contre le melange.
REDIS_PREFIX=vie_scolaire-

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://change-me:change-me@rabbitmq:5672/

# ============================================================
# Regle n°3 - Secret interne partage
# ============================================================
# Valeur fournie par le chef de projet, identique a celle utilisee
# par tous les autres microservices. Ne jamais en generer une
# locale : sinon plus personne ne peut vous appeler.
# Envoye dans l'entete `X-Internal-Secret`.
INTERNAL_API_SECRET=change-me

# URL de base des API internes des autres microservices, pour les
# appels inter-microservices. Aucune jointure SQL inter-schemas :
# on passe par ces endpoints (Regle n°1).
# Les ports sont ceux du tableau de la section « Regle n°6 » du
# README general de la plateforme.
IDENTITE_URL=http://identite:4001
SCOLARITE_URL=http://scolarite:change-me
RH_URL=http://rh:change-me

# ============================================================
# Regle n°4 - CAPTCHA partage
# ============================================================
# Un seul compte reCAPTCHA / hCaptcha pour toute la plateforme :
# meme provider, meme cle secrete, meme seuil que ceux deja
# utilises par identite (valeurs fournies par le chef de projet).
# La cle PUBLIQUE (celle du front-end) n'a rien a faire ici : elle
# n'est cote client, jamais dans le .env d'un backend.
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SECRET_KEY=change-me
CAPTCHA_MIN_SCORE=0.5

# ============================================================
# Regle n°6 - Port dedie du microservice
# ============================================================
# identite=4001, etablissements=4002, inscription=4003, scolarite=4004,
# vie_scolaire=4005.
VIESCOLAIRE_PORT=4005

# ============================================================
# Framework
# ============================================================
# PHP_CLI_SERVER_WORKERS=4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=vie_scolaire-cache

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="change-me@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

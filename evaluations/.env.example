APP_NAME=SIGAPEI-Evaluations
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:4006
APP_PORT=4006

CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

# --- PostgreSQL (schema "evaluations" — base unique partagee) ---
DB_CONNECTION=pgsql
DB_HOST=change-me
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_SCHEMA=evaluations
DB_SSLMODE=require

# --- Redis (DB 4 : identite=0, etablissements=1, inscription=2, scolarite=3, evaluations=4, finances=5, demandes=6) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=4
CACHE_STORE=redis

# --- RabbitMQ (partage avec api-identite) ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Secret interne partage (demandez la valeur au chef de projet) ---
INTERNAL_API_SECRET=change-me


# --- Stockage PDF bulletins (S3 ou MinIO) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- File asynchrone des PDF (CDC §14.2 : broker RabbitMQ) ---
QUEUE_CONNECTION=rabbitmq
RABBITMQ_QUEUE=evaluations.pdf

# --- Autres microservices (appels HTTP /interne, jamais de jointure SQL inter-schémas) ---
SCOLARITE_URL=http://api-scolarite:4004
SCOLARITE_TIMEOUT=5
# Phase 2 (compositions en ligne), bloquée tant que le contrat E-learning n'est pas validé
ELEARNING_URL=
ELEARNING_SERVICE_TOKEN=change-me

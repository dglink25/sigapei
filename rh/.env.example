APP_NAME=SIGAPEI-RH
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:4009
APP_PORT=4009

CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

# --- PostgreSQL (schema "rh" - base unique partagee) ---
DB_CONNECTION=pgsql
DB_HOST=change-me
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_SCHEMA=rh
DB_SSLMODE=require

# --- Redis (DB 7 : identite=0, etablissements=1, inscription=2, scolarite=3, evaluations=4, finances=5, demandes=6, rh=7) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=7
CACHE_STORE=redis

# --- RabbitMQ (partage avec les autres microservices) ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
# Publication des événements (false uniquement en test)
RABBITMQ_PUBLICATION=true

# --- Secret interne partage (demandez la valeur au chef de projet) ---
INTERNAL_API_SECRET=change-me

LOG_CHANNEL=stack
LOG_LEVEL=info

# --- File asynchrone (broker RabbitMQ) ---
QUEUE_CONNECTION=rabbitmq
RABBITMQ_QUEUE=rh.taches

# --- Autres microservices (appels HTTP /interne, jamais de jointure SQL inter-schémas) ---
SCOLARITE_URL=http://api-scolarite:4004
SCOLARITE_TIMEOUT=5
IDENTITE_URL=http://identite:4001
IDENTITE_TIMEOUT=5

# --- Parametres metier RH ---
RH_CONGES_JOURS_MAX=90

# ── Service ──
PORT=4010
NODE_ENV=development
API_PREFIX=v1
CORS_ORIGINS=http://localhost:5173
INTERNAL_API_SECRET=

# ── Base de données (schéma dédié "paiement") ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=paiement
DB_SSL=false
# Rôle PostgreSQL applicatif (sans droit propriétaire, pour que la RLS s'applique)
DB_ROLE_APPLICATIF=

# ── Redis / RabbitMQ ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_URL=
RABBITMQ_QUEUE_PAIEMENT=paiement.rpc

# ── Identité (vérification des jetons) ──
JWT_ACCESS_SECRET=
JWT_ISSUER=api-identite.sigapei.com

# ── Chiffrement (JAMAIS de valeur réelle dans le dépôt) ──
# Générer chaque clé :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLES_CHIFFREMENT={"1":""}
CLE_CHIFFREMENT_COURANTE=1
CLE_EMPREINTE=

# ── FedaPay ──
# Clés API disponibles dans votre tableau de bord FedaPay (sandbox ou live)
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# 'test' | 'live'
FEDAPAY_ENVIRONMENT=live
# URLs serveur : sandbox = https://sandbox-api.fedapay.com ; live = https://api.fedapay.com
FEDAPAY_API_URL=https://api.fedapay.com

# ── Kkiapay ──
# Les trois clés (public, private, secret) disponibles dans votre tableau de bord Kkiapay
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# Secret hash défini lors de la configuration du webhook dans le dashboard Kkiapay
KKIAPAY_WEBHOOK_SECRET=
# 'false' (production) | 'true' (sandbox)
KKIAPAY_SANDBOX=false

# ── CinetPay ──
# Clés disponibles dans votre compte marchand CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_SECRET=
# Environnement : 'production' | 'test'
CINETPAY_ENVIRONMENT=production
# Base URL de l'API CinetPay
CINETPAY_API_URL=https://api-checkout.cinetpay.com/v2

# ── Notifications Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Notifications SMS (passerelle) ──
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_FROM=

# ── Notifications WhatsApp (Convessa ou équivalent) ──
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=

# ── Stockage reçus ──
# Chemin local ou URL S3-compatible ; les reçus ne sont JAMAIS supprimés
RECUS_STORAGE_PATH=./storage/recus
# Domaine de base pour les liens de vérification : {slug_etablissement}.{RECUS_VERIFY_DOMAIN}/paiement/verif/{code}
RECUS_VERIFY_DOMAIN=sigapei.bj
# Durée de validité d'un lien de téléchargement pour un invité (minutes)
RECUS_LIEN_DUREE_MINUTES=60

# ── Application ──
APP_BASE_URL=http://localhost:4010

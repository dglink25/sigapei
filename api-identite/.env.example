# ==============================================================
# api-identite - variables d'environnement (voir README.md)
# ==============================================================

# --- Application ---
PORT=4001
NODE_ENV=development
API_PREFIX=v1
CORS_ORIGINS=https://sigapei.com,https://api-gateway.sigapei.com

# --- PostgreSQL (schema "identite" de la base unique) ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=sigapei
DB_PASSWORD=change-me
DB_NAME=sigapei
DB_SCHEMA=identite
DB_SYNCHRONIZE=false
DB_SSL=false

# --- Redis (cache OTP, sessions, rate-limiting, liste noire JWT) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ (bus d'evenements inter-microservices) ---
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://sigapei:change-me@rabbitmq:5672
RABBITMQ_EXCHANGE=sigapei.events
RABBITMQ_QUEUE_IDENTITE=identite.rpc

# --- JWT / SSO ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=30d
JWT_ISSUER=api-identite.sigapei.com

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS_PER_WINDOW=3
OTP_RESEND_WINDOW_SECONDS=600

# --- Convessa (WhatsApp) ---
CONVESSA_API_URL=https://convessa.epac-uac-optica-chapter.bj
CONVESSA_API_KEY=pk_convessa_xxxxxx...xxxxxx

# --- Passerelle SMS maison ---
SMS_GATEWAY_URL=http://sms-gateway:8080
SMS_GATEWAY_API_KEY=change-me
SMS_GATEWAY_SENDER_POOL=+229XXXXXXXX,+229YYYYYYYY

# --- Email transactionnel (SMTP + mot de passe d'application) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=otp@sigapei.com
SMTP_APP_PASSWORD=change-me-app-password
SMTP_FROM="sigapei <otp@sigapei.com>"

# --- CAPTCHA ---
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SECRET_KEY=change-me
CAPTCHA_MIN_SCORE=0.5

# --- Firebase (Google / GitHub via Firebase Authentication) ---
FIREBASE_PROJECT_ID=sigapei-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sigapei-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- WebAuthn / FIDO2 ---
WEBAUTHN_RP_ID=sigapei.com
WEBAUTHN_RP_NAME=sigapei
WEBAUTHN_ORIGIN=https://app.sigapei.com
INTERNAL_API_SECRET=change-me-shared-secret-gateway

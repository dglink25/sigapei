# ============================================================
# inscription — Microservice Inscription (Admissions) — SIGAPEI
# Copier ce fichier vers .env : cp .env.example .env
# Generer une cle Laravel : php artisan key:generate
# ============================================================
APP_NAME=api-inscription
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4003
APP_PORT=4003

# --- Base de données PostgreSQL (Base UNIQUE Neon, schéma dédié "inscription") ---
# Le microservice opère sur son propre schéma PostgreSQL isolé ("inscription")
# au sein de la base de données centrale partagée Neon ("neondb").
# Obtenir les credentials auprès du chef de projet (Neon Dashboard → Project → Connection string)
DB_CONNECTION=pgsql
DB_HOST=your-neon-project.pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=inscription
DB_SSLMODE=require
DB_ENDPOINT=your-neon-endpoint-id

# --- Redis Partagé (Base Redis n°2 dédiée à Inscription sur le réseau Docker "sigapei") ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# --- RabbitMQ Partagé (Bus d'événements inter-microservices sur le réseau "sigapei") ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
RABBITMQ_EXCHANGE=sigapei.events
RABBITMQ_QUEUE_INSCRIPTION=inscription.events

# --- JWT SSO (Emis par api-identite — NE JAMAIS LAISSER DE VALEUR PAR DEFAUT) ---
# Obtenir la valeur auprès du chef de projet (partagée avec api-identite et l'API Gateway)
JWT_ACCESS_SECRET=
JWT_ALGO=HS256
JWT_ISSUER=api-identite.sigapei.com

# --- Secret Interne Partagé (Passerelle Gateway & Appels inter-services) ---
# Generer avec : openssl rand -hex 32
# Synchroniser la même valeur avec l'API Gateway et tous les microservices
INTERNAL_API_SECRET=

# --- CAPTCHA (reCAPTCHA v3 ou hCaptcha pour soumissions publiques) ---
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5

# --- Stockage Objet (S3 / MinIO) pour pièces justificatives ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Logging & Audit ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================================
# scolarite — Microservice Scolarité — SIGAPEI
# ============================================================
APP_NAME=scolarite
APP_ENV=local
APP_KEY=base64:c2lnYXBlaS1zY29sYXJpdGUtc2VjcmV0LWtleS0yMDI2
APP_DEBUG=true
APP_URL=http://localhost:4004
APP_PORT=4004

# --- Base de données PostgreSQL (Base unique Neon, schéma "scolarite") ---
DB_CONNECTION=pgsql
DB_HOST=ep-raspy-brook-b46yo20b-pooler.c-6.us-east-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=change-me-fourni-par-le-chef
DB_PASSWORD=change-me-fourni-par-le-chef
DB_SCHEMA=scolarite
DB_SSLMODE=require

# --- Redis Partagé (Base Redis n°3 dédiée à Scolarité) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# --- RabbitMQ Partagé (Bus d'événements inter-microservices) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
RABBITMQ_EXCHANGE=sigapei.events
RABBITMQ_QUEUE_SCOLARITE=scolarite.events

# --- JWT SSO (Émis par identite) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ALGO=HS256
JWT_ISSUER=api-identite.sigapei.com

# --- Secret Interne Partagé (Passerelle Gateway / Inter-services) ---
INTERNAL_API_SECRET=change-me-shared-secret-gateway

# --- CORS & Passerelle ---
CORS_ALLOWED_ORIGINS=https://sigapei.com,https://api-gateway.sigapei.com,http://localhost:3000

# --- Stockage Objet (S3 / MinIO) pour documents scolaires ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Logging & Audit ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

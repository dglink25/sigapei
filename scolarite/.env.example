# ============================================================
# api-scolarite — Configuration d'environnement
# ============================================================
APP_NAME=api-scolarite
APP_ENV=local
APP_KEY=base64:c2lnYXBlaS1zY29sYXJpdGUtc2VjcmV0LWtleS0yMDI2
APP_DEBUG=true
APP_URL=http://localhost:4004
APP_PORT=4004

# --- Base de donnees PostgreSQL (Schema "scolarite" de la base unique) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sigapei
DB_USERNAME=sigapei
DB_PASSWORD=change-me
DB_SCHEMA=scolarite
DB_SSLMODE=prefer

# --- JWT SSO (partage avec api-identite) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ALGO=HS256
JWT_ISSUER=api-identite.sigapei.com

# --- Secret interne passerelle API (Gateway) ---
INTERNAL_API_SECRET=change-me-shared-secret-gateway

# --- CORS & Passerelle ---
CORS_ALLOWED_ORIGINS=https://sigapei.com,https://api-gateway.sigapei.com,http://localhost:3000

# --- Stockage Objet (S3 / MinIO) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Logging & Audit ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

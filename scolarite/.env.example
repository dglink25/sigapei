APP_NAME=api-scolarite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:4004
APP_PORT=4004

# Obtenir les credentials auprès du chef de projet (Neon Dashboard → Project → Connection string)
DB_CONNECTION=pgsql
MICROSERVICES_TIMEOUT=15
TWO_TENANT_CONVENTIONS_ENABLED=true
DB_HOST=your-neon-project.pooler.region.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=scolarite
DB_SSLMODE=require
DB_ENDPOINT=your-neon-endpoint-id

# --- Redis Partagé (Base Redis n°3 dédiée à Scolarité sur le réseau Docker "sigapei") ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# --- RabbitMQ Partagé (Bus d'événements inter-microservices sur le réseau "sigapei") ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}
RABBITMQ_EXCHANGE=sigapei.events
RABBITMQ_QUEUE_SCOLARITE=scolarite.events

# Obtenir la valeur auprès du chef de projet (partagée avec api-identite et l'API Gateway)
JWT_ACCESS_SECRET=
JWT_ALGO=HS256
JWT_ISSUER=api-identite.sigapei.com

# Synchroniser la même valeur avec l'API Gateway et tous les microservices
INTERNAL_API_SECRET=

# --- URLs Microservices pour les appels internes ---
URL_SERVICE_IDENTITE=http://localhost:4001
URL_SERVICE_ETABLISSEMENTS=http://localhost:4002
URL_SERVICE_INSCRIPTION=http://localhost:4003
URL_SERVICE_SCOLARITE=http://localhost:4004
URL_SERVICE_VIE_SCOLAIRE=http://localhost:4005

# --- CORS & Passerelle ---
CORS_ALLOWED_ORIGINS=https://sigapei.com,https://api-gateway.sigapei.com,http://localhost:3000

# --- Stockage Objet (S3 / MinIO) pour documents scolaires ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Logging & Audit ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

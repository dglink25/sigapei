<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="base64:dGVzdC10ZXN0LXRlc3QtdGVzdC10ZXN0LXRlc3QtMTI=" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="LOG_CHANNEL" value="stderr" force="true"/>
        <env name="LOG_LEVEL" value="error" force="true"/>
        <env name="INTERNAL_API_SECRET" value="secret-de-test-interne-0123456789abcdef" force="true"/>
        <env name="IDENTITE_URL" value="http://identite.test" force="true"/>
        <env name="SCOLARITE_URL" value="http://scolarite.test" force="true"/>
        <env name="PAIEMENT_URL" value="http://paiement.test" force="true"/>
        <env name="CORS_ORIGINS" value="https://app.sigapei.test" force="true"/>
        <env name="RABBITMQ_HOST" value="" force="true"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="sigapei_test"/>
        <env name="DB_USERNAME" value="postgres"/>
        <env name="DB_PASSWORD" value="postgres"/>
        <env name="DB_SSLMODE" value="disable"/>
    </php>
</phpunit>

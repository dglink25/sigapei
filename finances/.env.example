APP_NAME=SIGAPEI-Finances
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:4008
APP_PORT=4008

# Origines du front : CORS et seules adresses de retour acceptées après un paiement en ligne
CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

DB_CONNECTION=pgsql
DB_HOST=change-me
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_SCHEMA=finances
DB_SSLMODE=require

# --- Redis (DB 5 : identite=0, etablissements=1, inscription=2, scolarite=3, evaluations=4, finances=5, demandes=6) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=5
CACHE_STORE=redis

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# Secret interne de la plateforme (identique partout, 32 caractères minimum, jamais généré localement)
INTERNAL_API_SECRET=change-me

# Services consommés (réseau interne sigapei)
IDENTITE_URL=http://api-identite:4001
IDENTITE_CODE_SERVICE=finances
SCOLARITE_URL=http://api-scolarite:4004
# Paiement : seul service qui manipule l'argent réel (agrégateurs). Finances ne détient aucune clé d'agrégateur.
PAIEMENT_URL=http://api-paiement:4010

LOG_CHANNEL=stack
LOG_LEVEL=info

  "components": {
    "securitySchemes": {
      "SecretInterne": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Secret",
        "description": "INTERNAL_API_SECRET de la plateforme (ajouté par la Gateway)"
      },
      "Tenant": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Tenant-Id",
        "description": "Établissement de l'utilisateur"
      },
      "Utilisateur": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id",
        "description": "uuid de l'utilisateur connecté"
      },
      "Role": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Role",
        "description": "Rôle de l'utilisateur connecté"
      }
    },
    "schemas": {
      "Erreur": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }

APP_NAME=SIGAPEI-Finances
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:4008
APP_PORT=4008

CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

DB_CONNECTION=pgsql
DB_HOST=change-me
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_SCHEMA=finances
DB_SSLMODE=require

# --- Redis (DB 5 : identite=0, etablissements=1, inscription=2, scolarite=3, evaluations=4, finances=5, demandes=6) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=5
CACHE_STORE=redis

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

INTERNAL_API_SECRET=change-me

FEDAPAY_SECRET_KEY=change-me
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=change-me

KKIAPAY_PRIVATE_KEY=change-me
KKIAPAY_PUBLIC_KEY=change-me
KKIAPAY_SECRET=change-me
KKIAPAY_SANDBOX=true

LOG_CHANNEL=stack
LOG_LEVEL=info

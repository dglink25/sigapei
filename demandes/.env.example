NODE_ENV=production
PORT=4007
API_PREFIX=v1

CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

# --- PostgreSQL (schema "demandes" de la base UNIQUE partagee) ---
DB_HOST=change-me
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_SCHEMA=demandes
DB_SSL=true
# DB_SYNCHRONIZE n'est pris en compte qu'avec NODE_ENV=development (poste local). JAMAIS en production.
DB_SYNCHRONIZE=false

# --- Redis (REDIS_DB=6 : identite=0, etablissements=1, inscription=2, scolarite=3, evaluations=4, finances=5, demandes=6) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=6

# --- RabbitMQ (partage avec api-identite) ---
RABBITMQ_URL=amqp://sigapei:change-me@127.0.0.1:5672/
RABBITMQ_EXCHANGE=sigapei.events

# --- Secret interne partage avec la passerelle API et les autres microservices ---
# Demandez la valeur au chef de projet, ne generez pas votre propre valeur.
INTERNAL_API_SECRET=change-me

SWAGGER_ENABLED=false

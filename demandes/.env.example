NODE_ENV=production
PORT=4007
API_PREFIX=v1

CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

# --- PostgreSQL (schema "demandes" de la base UNIQUE partagee) ---
DB_HOST=change-me
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_SCHEMA=demandes
DB_SSL=true

# --- RabbitMQ (partage avec api-identite) ---
RABBITMQ_URL=amqp://sigapei:change-me@127.0.0.1:5672/
RABBITMQ_EXCHANGE=sigapei.events

# --- Secret interne partage avec la passerelle API et les autres microservices ---
# Demandez la valeur au chef de projet, ne generez pas votre propre valeur.
INTERNAL_API_SECRET=change-me

# --- Autres microservices (appels /v1/interne/* avec le secret interne, jamais de jointure SQL) ---
# Identite : verification du jeton du front et acces au module ; Etablissements : uuid -> tenant_id
IDENTITE_URL=http://api-identite:4001
ETABLISSEMENTS_URL=http://api-etablissements:4002
SCOLARITE_URL=http://api-scolarite:4004
EVALUATIONS_URL=http://api-evaluations:4006
RH_URL=http://api-rh:4009
# Code de ce module dans le catalogue des services d'Identite
IDENTITE_CODE_SERVICE=demandes

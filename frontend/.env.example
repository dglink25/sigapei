# Variables d'environnement du frontend SIGAPEI
# Copiez ce fichier en .env et ajustez les valeurs pour votre environnement

# URLs des microservices (réseau Docker interne = noms de services)
# En développement local sans Docker, utilisez les ports localhost
VITE_API_INSCRIPTION_URL=http://api-inscription:4003
VITE_API_SCOLARITE_URL=http://api-scolarite:4004

# Environnement courant
VITE_APP_ENV=development

# Nom affiché de l'application (optionnel)
VITE_APP_NAME=SIGAPEI
VITE_APP_VERSION=1.0.0

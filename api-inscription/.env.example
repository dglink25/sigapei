# ============================================================
# api-inscription — Configuration d'environnement
# ============================================================
APP_NAME=api-inscription
APP_ENV=local
APP_KEY=base64:c2lnYXBlaS1pbnNjcmlwdGlvbi1zZWNyZXQta2V5LTIwMjY=
APP_DEBUG=true
APP_URL=http://localhost:4003
APP_PORT=4003

# --- Base de donnees PostgreSQL (Schema "inscription" de la base unique) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sigapei
DB_USERNAME=sigapei
DB_PASSWORD=change-me
DB_SCHEMA=inscription
DB_SSLMODE=prefer

# --- JWT SSO (partage avec api-identite) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ALGO=HS256
JWT_ISSUER=api-identite.sigapei.com

# --- Secret interne passerelle API (Gateway) ---
INTERNAL_API_SECRET=change-me-shared-secret-gateway

# --- Stockage Objet (S3 / MinIO) pour pieces justificatives ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Logging & Notifications ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

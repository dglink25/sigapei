

APP_NAME=SIGAPEI-Etablissements
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:4002
APP_PORT=4002

CORS_ORIGINS=https://sigapei.com,https://app.sigapei.com

# --- PostgreSQL (schema "etablissements" de la base UNIQUE partagee avec les autres microservices) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sigapei
DB_USERNAME=sigapei_owner
DB_PASSWORD=
DB_SCHEMA=etablissements
DB_SSLMODE=require

# --- Redis (cache resolution slug->tenant, cache pages d'accueil, cache referentiel geo) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=1
CACHE_STORE=redis
CACHE_TTL_SLUG=60
CACHE_TTL_ACCUEIL=120
CACHE_TTL_GEO=86400

# --- RabbitMQ (bus d'evenements inter-microservices, partage avec api-identite) ---
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=sigapei
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
# Queue consommee par api-identite pour la creation du compte administrateur
# et les autres evenements inter-microservices (voir README section RabbitMQ).
RABBITMQ_QUEUE_IDENTITE=identite.rpc

# --- Secret interne partage avec la passerelle API (Gateway) et les autres microservices ---
INTERNAL_API_SECRET=change-password-shared-secret-gateway

# --- Stockage objet des documents televerses (S3 ou MinIO) ---
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sigapei-documents-etablissements
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- CAPTCHA (identique a api-identite) ---
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SECRET_KEY=
CAPTCHA_MIN_SCORE=0.5

# --- Liens de correction a usage unique ---
CORRECTION_TOKEN_TTL_HEURES=72
FRONT_URL_CORRECTION=https://sigapei.com/demandes/correction

# --- Paiement des abonnements (distinct des paiements de scolarite) ---
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_WEBHOOK_SECRET=

KKIAPAY_PRIVATE_KEY=
KKIAPAY_PUBLIC_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

LOG_CHANNEL=stack
LOG_LEVEL=debug
